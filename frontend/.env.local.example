# OpenAI API Key para Voice Agent
# Obtenha sua chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# URL do OpenCut embutido na aplicação.
# Opções:
# - Produção (remoto): https://opencut.app  (pode bloquear iframe dependendo de headers do site)
# - Self-host/vendorizado (recomendado para auto-importar timeline): http://localhost:3000/opencut
#   Caso vendorize o OpenCut no mesmo domínio do seu app, a integração via postMessage funcionará melhor.
NEXT_PUBLIC_OPENCUT_URL=https://opencut.app
